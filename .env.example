# ==========================================
# Invoice Automation System Configuration
# ==========================================

# Database
DATABASE_URL=sqlite:///./invoices.db

# LLM Provider Configuration
# Options: "gemini", "openai", "mock" (default: "mock" for offline deterministic tests)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-2.5-flash

# Email Ingestion Configuration (IMAP)
# Options: "mock" (uses data/mock_inbox) or "imap"
EMAIL_SOURCE=mock
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@empresa.com
IMAP_PASSWORD=tu_app_password
IMAP_FOLDER=INBOX

# Accounting & Validation Rules
PO_TOLERANCE_PERCENTAGE=2.0
MAX_INVOICE_AGE_DAYS=90

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="Sistema Contable de Facturación con LLM"
DEBUG=True
